<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 Theme using AppCompat parent for XML compatibility -->
    <style name="Theme.BTSecTestTool" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/btsec_primary</item>
        <item name="colorPrimaryDark">@color/btsec_primary_dark</item>
        <item name="colorAccent">@color/btsec_secondary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/btsec_primary_dark</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background color -->
        <item name="android:colorBackground">@color/btsec_background</item>
        <item name="android:textColorPrimary">@color/btsec_on_background</item>
        <item name="android:textColorSecondary">@color/btsec_on_surface</item>

        <!-- Error color -->
        <item name="colorError">@color/btsec_critical</item>
    </style>
</resources>
