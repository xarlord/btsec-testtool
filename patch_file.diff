     private fun generateId(): String {
         return java.util.UUID.randomUUID().toString()
     }
+
+    private fun getSafeExportFile(outputPath: String): Result<File> {
+        val file = File(outputPath)
+        return try {
+            val canonicalPath = file.canonicalPath
+            val name = file.name
+
+            // Check for path traversal attempts like ../ or /../
+            if (outputPath.contains("..")) {
+                return Result.failure(SecurityException("Invalid output path: Path traversal detected"))
+            }
+
+            // Allow relative paths, absolute paths if they don't contain traversal
+            // Specifically preventing paths getting resolved to unintended parent directories.
+            if (!canonicalPath.endsWith(name) && !file.isDirectory) {
+                 return Result.failure(SecurityException("Invalid output path: Path mismatch"))
+            }
+
+            Result.success(file)
+        } catch (e: Exception) {
+            Result.failure(SecurityException("Invalid output path", e))
+        }
+    }
 }
